let currentSubject='', currentDeadline='';

function track(eventName, params={}) {
  if (typeof window.gtag === 'function') window.gtag('event', eventName, params);
  console.log('[event]', eventName, params);
}

function normalizeLine(line){
  return line
    .replace(/^\s*(?:[-*•▪︎◦]|\d+[\.\)]|[①-⑳]|\([0-9]+\))\s*/,'')
    .replace(/\*\*/g,'')
    .trim();
}

function condenseClause(raw){
  let t = raw;
  let obligation = false;
  let optional = false;

  const fillerLead = [/^총\s*/, /^참고로\s*/, /^그리고\s*/, /^또한\s*/, /^아울러\s*/,
    /^please\s+/i, /^kindly\s+/i, /^note that\s+/i, /^make sure to\s+/i, /^you (?:should|must|need to)\s+/i];
  for (const re of fillerLead) t = t.replace(re, '');

  const obligationEndings = /(?:(?:해|하)\s*주셔야\s*합니다|(?:하|되)셔야\s*합니다|(?:해|하)야\s*합니다|(?:하|되)여야\s*합니다)\.?/;
  const optionalEndings = /(?:선택사항(?:입니다|이며)?|선택입니다)\.?/;
  const requiredEndings = /(?:필수사항(?:입니다|이며)?|필수입니다)\.?/;

  if (obligationEndings.test(t)) { obligation = true; t = t.replace(obligationEndings, ''); }
  if (optionalEndings.test(t)) { optional = true; t = t.replace(optionalEndings, ''); }
  if (requiredEndings.test(t)) { obligation = true; t = t.replace(requiredEndings, ''); }

  const softEndings = [
    /(?:해|하)\s*주(?:시면|시기)?\s*됩니다\.?/g,
    /(?:해|하)\s*주세요\.?/g,
    /주시기\s*바랍니다\.?/g,
    /부탁\s*드립니다\.?/g,
    /(?:하|되)시기\s*바랍니다\.?/g,
    /바랍니다\.?/g,
    /됩니다\.?$/g,
    /합니다\.?$/g,
    /입니다\.?$/g,
  ];
  for (const re of softEndings) t = t.replace(re, '');

  // 자주 쓰이는 지시 동사 축약
  t = t.replace(/(?:적어|기재해|작성해|써)\s*주(?:시면|세요|시기\s*바랍니다)?/g, '작성');
  t = t.replace(/첨부한\s*/g, '첨부 ');
  t = t.replace(/선택사항$/, '선택').replace(/필수사항$/, '필수');

  t = t.replace(/\s{2,}/g, ' ').trim();
  t = t.replace(/^[,.]+|[,.]+$/g, '').trim();

  if (obligation && !/필수/.test(t)) t = (t ? t + ' 필수' : '필수');
  if (optional && !/선택/.test(t)) t = (t ? t + ' 선택' : '선택');

  return t.trim();
}

function condenseText(text){
  const clauses = text
    .split(/,\s*|되고\s*|하고\s*|이고\s*|이며\s*|며\s*/)
    .map(condenseClause)
    .filter(Boolean);

  let result = clauses.length ? clauses.join(', ') : text;

  const MAX = 60;
  if (result.length > MAX){
    const cut = result.slice(0, MAX);
    const lastSpace = cut.lastIndexOf(' ');
    result = (lastSpace > 20 ? cut.slice(0, lastSpace) : cut) + '…';
  }

  return result;
}

// v0.3: 문장 단위 분리 — 번호·불릿 없는 긴 문단도 처리
function splitIntoUnits(text){
  return text
    .replace(/([.!?。])\s+/g, '$1\n')                                         // 마침표/!/? 뒤 분리
    .replace(/((?:한다|된다|하라|합니다|습니다|입니다|됩니다|하십시오|하시오|하세요|해요|드립니다|바랍니다|바람|할\s*것))\s+(?=[가-힣A-Za-z0-9(])/g, '$1\n') // 명확한 종결어미 뒤에서만 분리(오분할 방지)
    .split(/\n+/)
    .map(s=>s.trim())
    .filter(Boolean);
}

function extractRequirements(text){
  const raw = splitIntoUnits(text);

  // 행동 명사 (실제로 '수행'하는 동사로 쓰일 때만 할 일로 인정)
  const ACTION = '작성|제시|설명|분석|비교|정의|선택|적용|포함|제출|구분|설계|검증|정리|구성|제안|반영|첨부|업로드|다운로드|기재|준수|충족|참여|완료|준비|수정|보완|조사|요약|번역|출력|입력|회신|응답|예약|결제|납부|서명|동의|인증|수강|출석|제작|등록|신청|확인|발표';

  // 의무/지시(=할 일) 문장만 추림: 행동명사+동사화 또는 지시·의무 종결어미
  const obligationRegex = new RegExp(
    '(?:' + ACTION + ')\\s*(?:하|해|한|합|하여|하기|해야|하세요|하십시오|하시오|할\\s*것|해\\s*주)'
    + '|하세요|하십시오|하시오|해야\\s*(?:한다|합니다|함|됩니다)|하여야\\s*(?:한다|합니다|함)|할\\s*것'
    + '|하기\\s*바[랍람]|주시기\\s*바랍니다|(?:해|하여)\\s*주(?:세요|십시오)|바랍니다|바람(?=\\s|$|\\.)|요망'
    + '|submit|deliverable|upload|register|complete|prepare|include',
    'i'
  );

  // 인사말·맺음말·채점 기준 (요구사항이 아님 → 제외)
  const greetingRegex = /(감사(합니다|드립니다|해요|합)|고맙습니다|고마워|안녕하세요|반갑습니다|수고(하셨|하세요|했)|화이팅|파이팅|응원(합니다|해)|건투|행운을|잘\s*부탁\s*드립니다|채점\s*기준|평가\s*기준|평가\s*방법|평가\s*항목|배점|만점|가점|감점|grading|rubric|criteria|scoring)/;

  // 경고문·조건문 (직접적인 할 일이 아님 → 제외)
  const warnCondRegex = /(하더라도|더라도|경우에만|경우에는|(?:있는|없는|인|한|될)\s*경우|않으셔도|않아도|않으시면|지\s*않으(?:면|셔도)|있으시면|없으시면|유의(?:해|하여|하시|사항)|유념|명심|불이익|감점|F\s*학점|부여\s*되|처리\s*됩니다|간주\s*(?:됩니다|합니다|된다|되)|경고|주의\s*(?:하|바랍|요망))/i;

  let items = [];

  for (const line of raw){
    const cleaned = normalizeLine(line);
    if (greetingRegex.test(cleaned)) continue;          // 인사말·채점기준 제외
    if (warnCondRegex.test(cleaned)) continue;          // 경고문·조건문 제외
    if (obligationRegex.test(cleaned) && cleaned.length >= 4 && cleaned.length <= 400) {
      items.push(cleaned);                              // 실제 '할 일'만 추가
    }
  }

  // 중복 제거
  items = [...new Set(items)];

  return items.slice(0, 15);
}

// v0.2: 중요도 태그 정의 및 자동 감지
const PRIOS = [
  { key:'high', label:'⭐ 높음', cls:'prio-high' },
  { key:'mid',  label:'보통',    cls:'prio-mid'  },
  { key:'low',  label:'낮음',    cls:'prio-low'  },
];
function detectPriority(text){
  if(/(필수|반드시|제출|마감|기한|평가|required|must|deadline|due)/i.test(text)) return 0; // 높음
  if(/(선택\s*사항|선택입니다|참고용|참고\s*바람|권장|optional|recommended)/i.test(text)) return 2; // 낮음
  return 1; // 보통
}

// v0.2: 과목명 + 마감일 D-day 표시
// v0.3: 할 일 문장을 간결한 명사형에 가깝게 정제
const _ACTION_ALT = '작성|제시|설명|분석|비교|정의|선택|적용|포함|제출|구분|설계|검증|정리|구성|제안|반영|첨부|업로드|다운로드|기재|준수|충족|참여|완료|준비|수정|보완|조사|요약|번역|출력|입력|회신|응답|예약|결제|납부|서명|동의|인증|수강|출석|제작|등록|신청|확인|발표';
const _FILLER = ['반드시','엄격히','꼭','필히','가급적','되도록','미리','사전에','충분히','성실히','빠짐없이','정확히','즉시','바로','각별히','먼저'];
const _DEADLINE_STRIP = /(?:\d{4}\s*[.\-/]\s*\d{1,2}\s*[.\-/]\s*\d{1,2}\s*(?:일)?\s*(?:전)?\s*까지|\d{1,2}\s*월\s*\d{1,2}\s*일\s*(?:전)?\s*까지|(?:다음|이번|오는|금)\s*주(?:\s*[월화수목금토일]요일)?\s*(?:전)?\s*까지|[월화수목금토일]요일\s*(?:전)?\s*까지|[가-힣A-Za-z0-9]+\s*전\s*까지)/;

function cleanTask(text){
  let t = text;
  t = t.replace(_DEADLINE_STRIP, ' ');                  // 마감 표현 제거
  for(const a of _FILLER) t = t.split(a).join('');       // 부사 제거
  // 존댓말·연결 꼬리 제거 (긴 것부터)
  const tails = [
    /,?\s*(?:이\s*점\s*)?유의(?:해|하여)?\s*주시기\s*바랍니다\.?$/,
    /(?:해|하여|하)?\s*주시기\s*바랍니?다?\.?$/,
    /(?:해|하여)?\s*주(?:시면|세요|십시오)(?:\s*됩니다)?\.?$/,
    /하(?:십시오|시오|세요)\.?$/,
    /(?:해야|하여야|되어야)\s*(?:한다|합니다|함|됩니다)\.?$/,
    /하기\s*바[랍람]니?다?\.?$/,
    /할\s*것\.?$/,
    /(?:바랍니다|바람|요망)\.?$/,
    /(?:됩니다|입니다|습니다)\.?$/,
  ];
  for(const re of tails) t = t.replace(re,'').trim();
  t = t.replace(/[,\s]+$/,'').trim();
  // 끝 동사어간→명사, 목적어 조사 정리
  t = t.replace(new RegExp('((?:'+_ACTION_ALT+'))(?:하여|해|하|합|한다)\\s*$'), '$1');
  t = t.replace(new RegExp('(?:을|를|이|가)\\s+((?:'+_ACTION_ALT+'))\\s*$'), ' $1');
  t = t.replace(/\s{2,}/g,' ').trim().replace(/^[,.\s]+|[,.\s]+$/g,'');
  return nominalize(t) || text;                          // 명사형 종결어미로 통일
}

// 명사형 종결어미로 끝내기: -하기 / -음(ㅁ) / -(을/ㄹ)것
function nominalize(t){
  t = t.replace(/[.\s]+$/,'').trim();
  if(!t) return t;
  if(/(?:음|함|기|것)$/.test(t)) return t;                        // 이미 명사형이면 유지
  if(new RegExp('(?:'+_ACTION_ALT+')$').test(t)) return t + '하기'; // 제출 → 제출하기
  t = t.replace(/(?:하여|하다|한다|합니다|해요|하세요|해)$/, '하기'); // 동사 → 하기
  return t;
}

function renderMeta(){
  meta.innerHTML='';
  if(!currentSubject && !currentDeadline){ meta.classList.remove('show'); return; }
  if(currentSubject){
    const subj=document.createElement('span');
    subj.className='subj';
    subj.textContent=currentSubject;
    meta.appendChild(subj);
  }
  if(currentDeadline){
    meta.appendChild(document.createTextNode((currentSubject?' · ':'')+'마감 '+currentDeadline));
    const today=new Date(); today.setHours(0,0,0,0);
    const d=new Date(currentDeadline+'T00:00:00');
    const diff=Math.round((d-today)/(1000*60*60*24));
    const dd=document.createElement('span');
    dd.className='dday';
    if(diff>0){ dd.textContent='D-'+diff; if(diff<=3) dd.classList.add('soon'); }
    else if(diff===0){ dd.textContent='D-DAY'; dd.classList.add('today'); }
    else { dd.textContent='마감 지남 D+'+(-diff); dd.classList.add('over'); }
    meta.appendChild(dd);
  }
  meta.classList.add('show');
}

function render(items){
  list.innerHTML='';
  if(!items.length){
    list.innerHTML='<div class="empty">요구사항을 찾기 어려워. 번호나 불릿이 포함된 과제 안내문을 붙여넣어 봐.</div>';
    result.style.display='block';
    score.textContent='0 / 0 완료';
    return;
  }

  items.forEach((text, idx)=>{
    const li=document.createElement('li');
    const cb=document.createElement('input');
    cb.type='checkbox';
    cb.addEventListener('change', updateScore);
    const span=document.createElement('span');
    span.className='item-text';
    span.textContent = cleanTask(text);   // 전체 표시 (더보기/접기 없음)
    // 문장을 클릭해도 체크박스 토글
    span.addEventListener('click', ()=>{ cb.checked=!cb.checked; updateScore(); });

    // v0.2 중요도 태그: 자동 감지 후 클릭으로 조정
    const prio=document.createElement('button');
    prio.type='button';
    prio.title='클릭해서 중요도 변경';
    let pi=detectPriority(text);
    function paintPrio(){
      prio.textContent=PRIOS[pi].label;
      prio.className='prio '+PRIOS[pi].cls;
    }
    paintPrio();
    prio.addEventListener('click', ()=>{
      pi=(pi+1)%PRIOS.length;
      paintPrio();
      track('priority_set',{priority:PRIOS[pi].key});
    });

    // v0.2 순서 이동: 위/아래 버튼
    const move=document.createElement('span');
    move.className='move';
    const up=document.createElement('button');
    up.type='button'; up.className='mv'; up.textContent='▲'; up.title='위로 이동';
    const down=document.createElement('button');
    down.type='button'; down.className='mv'; down.textContent='▼'; down.title='아래로 이동';
    up.addEventListener('click',()=>{
      const prev=li.previousElementSibling;
      if(prev){ list.insertBefore(li, prev); updateMoveButtons(); track('item_moved',{dir:'up'}); }
    });
    down.addEventListener('click',()=>{
      const next=li.nextElementSibling;
      if(next){ list.insertBefore(next, li); updateMoveButtons(); track('item_moved',{dir:'down'}); }
    });
    move.append(up, down);

    li.append(cb, span, prio, move);
    list.appendChild(li);
  });
  updateMoveButtons();
  result.style.display='block';
  updateScore();
}

function updateMoveButtons(){
  const lis=[...list.querySelectorAll('li')];
  lis.forEach((li,i)=>{
    const btns=li.querySelectorAll('.mv');
    if(btns.length<2) return;
    btns[0].disabled=(i===0);
    btns[1].disabled=(i===lis.length-1);
  });
}

function updateScore(){
  const boxes=[...list.querySelectorAll('input[type=checkbox]')];
  const done=boxes.filter(b=>b.checked).length;
  score.textContent=`${done} / ${boxes.length} 완료`;
  const allDone = boxes.length>0 && done===boxes.length;
  doneMsg.classList.toggle('show', allDone);
  doneBtn.disabled = !allDone;
  if(allDone){
    if(!doneMsg.dataset.fired){
      doneMsg.dataset.fired='1';
      track('checklist_completed',{item_count:boxes.length});
    }
  } else {
    delete doneMsg.dataset.fired;
  }
}

function resetToStart(){
  input.value='';
  list.innerHTML='';
  result.style.display='none';
  score.textContent='0 / 0 완료';
  doneMsg.classList.remove('show');
  delete doneMsg.dataset.fired;
  doneBtn.disabled=true;
  currentSubject=''; currentDeadline='';
  renderMeta();
}

doneBtn.addEventListener('click',()=>{
  track('checklist_submitted');
  alert('수고하셨습니다! 🎉');
  resetToStart();
});

const infoModal = document.getElementById('infoModal');
const subjectInput = document.getElementById('subjectInput');
const deadlineInput = document.getElementById('deadlineInput');

document.getElementById('generate').addEventListener('click',()=>{
  const text=input.value.trim();
  if(!text){ alert('과제 안내문을 먼저 붙여넣어 줘.'); return; }
  subjectInput.value='';
  deadlineInput.value='';
  infoModal.classList.add('open');
  subjectInput.focus();
});

document.getElementById('modalCancel').addEventListener('click',()=>{
  infoModal.classList.remove('open');
});

document.getElementById('modalConfirm').addEventListener('click', async ()=>{
  const subject = subjectInput.value.trim();
  const deadline = deadlineInput.value;
  if(!subject){ alert('과목명을 입력해 줘.'); return; }
  if(!deadline){ alert('마감일을 선택해 줘.'); return; }

  infoModal.classList.remove('open');

  await saveUsageRecord(subject, deadline);

  currentSubject = subject;
  currentDeadline = deadline;
  const text=input.value.trim();
  const items=extractRequirements(text);
  render(items);
  renderMeta();
  track('checklist_generated',{item_count:items.length, subject, deadline});
});

document.getElementById('sample').addEventListener('click',()=>{
  input.value=`1. 전공 관련 의사결정 문제를 정확히 정의한다.
2. 문제를 구조화하고 원인을 분석한다.
3. 적합한 AI 의사결정 방법을 선택하고 적용한다.
4. 선택한 방법의 이유를 설명한다.
5. AI 방법의 한계를 분석한다.
6. 한계에 대한 대응 전략을 설계한다.
7. 최종 결과와 시사점을 정리한다.`;
  track('sample_loaded');
});

document.getElementById('copy').addEventListener('click',async()=>{
  const items=[...list.querySelectorAll('li .item-text')].map(s=>`- [ ] ${s.textContent}`);
  if(!items.length) return;
  let header='';
  if(currentSubject || currentDeadline){
    header='📋 ';
    if(currentSubject) header+=currentSubject;
    if(currentDeadline) header+=(currentSubject?' · ':'')+'마감: '+currentDeadline;
    header+='\n\n';
  }
  await navigator.clipboard.writeText(header + items.join('\n'));
  alert('체크리스트를 복사했어.');
  track('checklist_copied',{item_count:items.length});
});

document.getElementById('reset').addEventListener('click',()=>{
  list.querySelectorAll('input[type=checkbox]').forEach(b=>b.checked=false);
  updateScore();
  track('checklist_reset');
});
</script>
</body>
